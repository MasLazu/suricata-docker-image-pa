# Environment variables for Suricata Docker image
# Copy this file to .env and customize as needed

# Suricata mode: 'ids' for Intrusion Detection System or 'ips' for Intrusion Prevention System
SURICATA_MODE=ids

# Home network definition (required for Suricata to work properly)
HOME_NET=192.168.1.0/24

# Port groups
HTTP_PORTS=80
SSH_PORTS=22

# Network interfaces to monitor (must match container network setup)
INTERFACE1=eth0
INTERFACE2=eth1

# User and group IDs for file permissions (optional, for custom user mapping)
PUID=1000
PGID=1000

# Enable cron for scheduled tasks (e.g., log rotation)
ENABLE_CRON=yes

# Additional Suricata command-line options (optional)
SURICATA_OPTIONS=

# Optional Suricata pcap-log output (only one mode at a time)
# supported values: off, all, alerts, tag
PCAP_MODE=off
# Base directory for PCAP files inside the container
PCAP_DIR=pcap
# Max size per PCAP file before rotation
PCAP_LIMIT=100mb
# Number of rotated PCAP files to keep per output
PCAP_MAX_FILES=1000